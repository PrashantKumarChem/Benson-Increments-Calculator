# Keep line endings identical on every platform.
#
# tools/build_data.py writes manifest.json with LF endings, and CI checks the
# committed copy is current with `git diff --exit-code`. Without this, a
# contributor on Windows would see that check fail on line endings alone.

* text=auto

*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.cff   text eol=lf

*.ipynb text eol=lf

# Images and fonts are binary. `* text=auto` above would otherwise leave it to
# content detection, which is reliable but silent; saying so here means a
# screenshot cannot be corrupted by line-ending translation.
*.png   -text
*.jpg   -text
*.jpeg  -text
*.gif   -text
*.webp  -text
*.woff2 -text
